{
	"name": "neuralgist",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"start": "node build",
		"db:migrate": "prisma migrate deploy",
		"db:dev": "prisma migrate dev",
		"db:seed": "prisma db seed",
		"db:studio": "prisma studio",
		"postinstall": "prisma generate",
		"build:worker": "esbuild radio-worker/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=radio-worker/dist/index.mjs --external:@aws-sdk/* --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\""
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.2",
		"@types/pg": "^8.23.1",
		"@types/sanitize-html": "^2.16.1",
		"esbuild": "^0.28.2",
		"prisma": "^7.10.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.127.0",
		"@auth/core": "^0.41.3",
		"@auth/sveltekit": "^1.11.3",
		"@aws-sdk/client-s3": "^3.1136.0",
		"@lucide/svelte": "^1.47.0",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"dotenv": "^18.0.1",
		"hash-wasm": "^4.12.0",
		"highlight.js": "^11.12.0",
		"marked": "^18.0.13",
		"marked-highlight": "^2.2.4",
		"pg": "^8.23.0",
		"sanitize-html": "^2.17.7",
		"slugify": "^1.6.9",
		"zod": "^4.6.5"
	}
}
