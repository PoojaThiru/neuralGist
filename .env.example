# Postgres connection string (Neon, Supabase, Prisma Postgres, or local)
DATABASE_URL="postgresql://user:password@host:5432/neuralgist?sslmode=require"
# 32+ random chars. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# The first account registered/seeded with this email becomes ADMIN
ADMIN_EMAILS="you@example.com"
# Used only by `npm run db:seed` to create the admin account
ADMIN_PASSWORD=""
# Public URL of the site (used for metadata, sitemap, OG tags)
PUBLIC_SITE_URL="https://neuralgist.ai"
# Optional social sign-in — register the callback https://neuralgist.ai/auth/callback/<provider>
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# Shared secret between the site and the radio worker Lambda (set by Terraform in production)
RADIO_SECRET=""
